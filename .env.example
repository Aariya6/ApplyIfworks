## AI is optional -- every feature has a deterministic fallback when this is left blank.
## Any OpenAI-compatible chat-completions endpoint works, including Google's Gemini via its
## OpenAI-compatible endpoint (shown below) or OpenAI itself.
AI_PROVIDER=openai_compatible
AI_API_KEY=
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL=gemini-2.5-flash

# Application defaults
RJP_MODE=DRY_RUN
RJP_HOST=127.0.0.1
RJP_PORT=8765
# 0 = unlimited. Hard cap on real submissions per day, enforced before every real application.
RJP_MAX_DAILY_APPLICATIONS=30
# Required on Windows: Playwright's bundled Chromium is never on PATH under a bare "chromium"
# name. Find yours under %LOCALAPPDATA%\ms-playwright\chromium-*\chrome-win64\chrome.exe after
# running `playwright install chromium`.
RJP_CHROMIUM_EXECUTABLE=

# Optional: enables the google_jobs_search source in config/sources.yaml (disabled by default).
# Get a free-tier key at https://serpapi.com/ -- this is a legitimate paid search API that
# surfaces real Google Jobs results, not raw scraping of google.com. Leave blank to skip it.
SERPAPI_API_KEY=
